Options -MultiViews
RewriteEngine On
RewriteBase /

# Skip rewriting if already accessing dist/
RewriteCond %{REQUEST_URI} ^/dist/
RewriteRule ^ - [L]

# If the file exists inside dist/, serve it from there
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ /dist/$1 [L]

# If the directory exists inside dist/, serve it from there
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -d
RewriteRule ^(.*)$ /dist/$1 [L]

# SPA fallback: serve dist/index.html for all other routes (React Router)
RewriteRule ^ /dist/index.html [L]
